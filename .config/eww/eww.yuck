(deflisten workspaces :initial "[]"
  `/home/untemi/.config/eww/scripts/workspaces-watcher.sh`)

(defpoll clock :interval "1s" :initial ""
  `date '+%a, %b %d - %I:%M %p'`)

(defpoll calendar :interval "60s" :initial '{"title":"","today":0,"weeks":[]}'
  `/home/untemi/.config/eww/scripts/calendar.sh`)

(defpoll updates :interval "3600s" :initial '{"text":"","tooltip":""}'
  `/home/untemi/.config/eww/scripts/updates.sh`)

(defpoll battery :interval "5s" :initial '{"text":"","tooltip":""}'
  `/home/untemi/.config/eww/scripts/battery.sh`)

(defpoll disk :interval "30s" :initial '{"text":"","tooltip":""}'
  `/home/untemi/.config/eww/scripts/disk.sh`)

(defpoll memory :interval "4s" :initial '{"text":"","tooltip":""}'
  `/home/untemi/.config/eww/scripts/memory.sh`)

(deflisten backlight :initial ""
  `/home/untemi/.config/eww/scripts/backlight-watcher.sh`)

(deflisten audio :initial '{"text":"","tooltip":""}'
  `/home/untemi/.config/eww/scripts/audio-watcher.sh`)

(deflisten language :initial ""
  `/home/untemi/.config/eww/scripts/language-watcher.sh`)

(deflisten privacy :initial '{"text":"","tooltip":""}'
  `privacy-monitor`)

(defpoll gamemode :interval "5s" :initial ""
  `/home/untemi/Scripts/gamemode.sh`)

(defpoll hsrpower :interval "200s" :initial '{"text":"","tooltip":""}'
  `/usr/bin/timeout 20 /home/untemi/Scripts/hsr.sh power 2>/dev/null || printf '{"text":"","tooltip":""}'`)

(defpoll genshin :interval "200s" :initial '{"text":"","tooltip":""}'
  `/usr/bin/timeout 20 /home/untemi/Scripts/genshin.sh resin 2>/dev/null || printf '{"text":"","tooltip":""}'`)

(defwidget workspaces-widget []
  (box :class "workspaces" :orientation "h" :space-evenly false
    (for ws in workspaces
      (button :class { ws.urgent ? "ws-urgent" : (ws.focused ? "ws-active" : "ws-inactive") }
              :onclick "swaymsg workspace ${ws.num > 0 ? ws.num : ws.name}"
        (label :text {ws.display})))))

(defwidget clock-widget []
  (tooltip
    (box :class "calendar" :orientation "v" :space-evenly false
      (label :class "cal-title" :text {calendar.title})
      (box :class "cal-wd" :orientation "h" :space-evenly true
        (for wd in {["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]}
          (label :text wd)))
      (for week in {calendar.weeks}
        (box :class "cal-row" :orientation "h" :space-evenly true
          (for d in {week}
            (label :class { d.o ? "cal-day cal-dim" : (d.t ? "cal-day cal-today" : "cal-day") }
                   :text {d.d})))))
    (label :class "clock" :text clock :unindent false)))

(defwidget updates-widget []
  (tooltip
    (label :markup {updates.tooltip})
    (label :class "updates" :markup {updates.text})))

(defwidget tray-widget []
  (systray :class "tray" :spacing 3 :icon-size 17))

(defwidget gamemode-widget []
  (label :class "gamemode" :text gamemode :tooltip "Gamemode active"))

(defwidget privacy-widget []
  (label :class {privacy.text == "" ? "privacy" : "privacy privacy-active"}
         :markup {privacy.text} :tooltip {privacy.tooltip}))

(defwidget hsrpower-widget []
  (label :class "hsrpower"
    :markup "<span color='#7aa2f7' rise='600' font='10'>  </span>${hsrpower.text}"
    :tooltip {hsrpower.tooltip}))

(defwidget genshin-widget []
  (label :class "genshin"
    :markup "<span color='#7aa2f7' rise='-500' font='10'>&#xf186; </span>${genshin.text}"
    :tooltip {genshin.tooltip}))

(defwidget battery-widget []
  (label :class "battery" :markup {battery.text} :tooltip {battery.tooltip}))

(defwidget disk-widget []
  (label :class "disk" :markup {disk.text} :tooltip {disk.tooltip}))

(defwidget memory-widget []
  (label :class "memory" :markup {memory.text} :tooltip {memory.tooltip}))

(defwidget backlight-widget []
  (eventbox :class "backlight"
            :onscroll "if [ {} = up ]; then brightnessctl set 5%+; else brightnessctl set 5%-; fi"
            :cursor "pointer"
    (label :class "backlight-label" :markup backlight)))

(defwidget audio-widget []
  (eventbox :class "audio"
            :onscroll "if [ {} = up ]; then wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+; else wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; fi"
            :cursor "pointer"
    (button :class "audio-btn"
            :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
      (label :class "audio-label" :markup {audio.text} :tooltip {audio.tooltip}))))

(defwidget language-widget []
  (label :class "language" :text language))

(defwidget bar-widget []
  (centerbox :class "bar" :orientation "h"
    (box :class "modules-left" :halign "start" :space-evenly false
      (workspaces-widget))
    (box :class "modules-center" :orientation "h" :space-evenly false
      (updates-widget)
      (clock-widget)
      (tray-widget))
    (box :class "modules-right" :halign "end" :orientation "h" :space-evenly false
      (gamemode-widget)
      (privacy-widget)
      (hsrpower-widget)
      (genshin-widget)
      (battery-widget)
      (disk-widget)
      (memory-widget)
      (backlight-widget)
      (audio-widget)
      (language-widget))))

(defwindow bar
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "26px"
                      :anchor "top center")
  :stacking "fg"
  :exclusive true
  (bar-widget))
